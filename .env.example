# ── Access passwords ────────────────────────────────────────────────
# Faculty (viewer) password for the landing-page gate.
ECC_POCUS_PASSWORD=PHSUPOCUS26
# Editor password — unlocks editor mode (Studio links + legacy editor).
ECC_POCUS_EDITOR_PASSWORD=PHSUEDITOR26

# ── Sanity (content management) ─────────────────────────────────────
# Project "ecc-pocus-faculty-info" — see studio-ecc-pocus-faculty-info/.
# Setting the project id switches the site from the src/content markdown
# files to Sanity. Only set it in production AFTER running the one-time
# import (npm run sanity:migrate), or the site will show no modules.
NEXT_PUBLIC_SANITY_PROJECT_ID=8i37d72u
NEXT_PUBLIC_SANITY_DATASET=production
# The deployed Studio URL (from `npm run deploy` in the studio folder,
# e.g. https://ecc-pocus-faculty-info.sanity.studio) — enables the
# editor-mode "Edit in Studio" buttons. http://localhost:3333 in dev.
NEXT_PUBLIC_SANITY_STUDIO_URL=
# Editor token (sanity.io/manage → API → Tokens), only needed for the
# one-time `npm run sanity:migrate` import. Never expose as NEXT_PUBLIC_*.
SANITY_API_WRITE_TOKEN=

# ── Git-backed fallback editor (legacy, used when Sanity is not set) ─
# Fine-grained GitHub token with Contents read/write for this repo; lets
# the built-in /editor pages commit changes so Vercel republishes them.
GITHUB_TOKEN=
# Defaults: repo noobmd25/ecc-pocus-faculty-info, branch = deployed branch.
# GITHUB_REPO=
# GITHUB_BRANCH=
